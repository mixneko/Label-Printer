{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Label Printer",
  "version": "1.0.3",
  "identifier": "tw.b51.labelprinter",
  "mainBinaryName": "Label Printer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Label Printer", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600, "visible": false }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com ws://localhost:* ws://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyQUEyNEI0N0Y3ODg4QjkKUldTNWlIaC90Q1NxWWxHOG9XcWRLWEVjWk5EdTdCSEN1VU9mWTQ0NnczYWh5Nm8vd3BhRUxXYTQK",
      "endpoints": ["https://github.com/mixneko/Label-Printer/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      { "ext": ["lpxl"], "name": "Label Printer 標籤檔", "description": "Label Printer 標籤檔", "role": "Editor", "mimeType": "application/json" }
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "both", "languages": ["TradChinese", "SimpChinese", "English", "Spanish", "German", "Japanese", "Korean"], "displayLanguageSelector": true }
    }
  }
}
